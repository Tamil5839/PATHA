{
  "name": "patha",
  "version": "1.0.0",
  "description": "Memorize any text with the word-weaving recitation patterns of the Vedic oral tradition. A static, private, offline-friendly web app.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "fake-indexeddb": "6.2.5"
  }
}
